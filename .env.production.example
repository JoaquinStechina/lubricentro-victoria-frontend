# Copiar a lubricentro-victoria-front/.env en el VPS (no commitear).
# NEXT_PUBLIC_API_URL NO va acá: se pasa como build-arg en infra/docker-compose.yml
# (variable PUBLIC_URL de infra/.env), porque se hornea en build time.

# Mismo valor que JWT_SECRET en backend/.env — usado server-side en
# proxy.ts / app/lib/session.ts para verificar la cookie de sesión.
JWT_SECRET=
